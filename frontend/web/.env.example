# Empty base URL: requests go to /api and Vite proxies them to the backend, so the
# browser stays same-origin in development.
VITE_API_BASE_URL=

# --- Maps --------------------------------------------------------------------
# Google Maps renders every map when this is set, and MapLibre over OpenStreetMap
# tiles renders them when it is not - so development and self-hosting work with no
# billing account, at the cost of Google's rendering.
#
# This key is PUBLIC. Anything the browser sends, a reader can read, and there is
# no arrangement in which a browser calls Google without the key being visible.
# What keeps it from being abused is a restriction on the key itself:
#
#   * a different key from MADO_GOOGLE_MAPS_API_KEY, which is the server's and
#     must never reach the browser - the server's key can spend on Places and
#     Geocoding, and a leaked one is a bill;
#   * restricted by HTTP referrer to your own domains;
#   * with only the Maps JavaScript API enabled on it.
VITE_GOOGLE_MAPS_API_KEY=

# A cloud-styled map. Google styles vector maps from the console now - the old
# inline styles array is ignored - and a map id is also what advanced markers
# require, so without one the maps fall back to Google's default styling and
# classic markers.
VITE_GOOGLE_MAPS_MAP_ID=

# Only read when there is no Google key. Any MapLibre style URL, for a deployment
# with its own vector tile vendor. OpenStreetMap's own tile servers are a
# courtesy, not a CDN, and their usage policy rules out heavy commercial traffic -
# so a keyless production deployment must set this to its own vendor.
VITE_MAP_STYLE_URL=
