# Mado local development configuration.
# Copy to .env and adjust. Never commit the populated file (spec 82.01 s18).

MADO_ENVIRONMENT=development
MADO_DEBUG=false

# --- Data platform -----------------------------------------------------------
MADO_DATABASE_URL=postgresql+psycopg://mado:mado@localhost:5432/mado
MADO_REDIS_URL=redis://localhost:6379/0

# --- Search (spec 82.01: Meilisearch primary, retrieval only) ----------------
MADO_MEILISEARCH_URL=http://localhost:7700
MADO_MEILISEARCH_API_KEY=mado-dev-master-key

# ---te Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MADO_JWT_SECRET=dev-only-change-me-before-any-shared-environment
MADO_ACCESS_TOKEN_TTL_MINUTES=30
MADO_REFRESH_TOKEN_TTL_DAYS=30

# --- AI Gateway --------------------------------------------------------------
# Provider stays behind the internal gateway; clients never see it (spec 82.02 s6).
# Leave the key blank to run the deterministic offline provider, which keeps the
# concierge fully usable without network access or spend - but note that intent
# comprehension then falls back to pattern matching, which understands far less.
MADO_AI_PROVIDER=stub
MADO_GEMINI_API_KEY=
# Embeddings are configured separately from chat generation: they cost far less,
# so real semantic search with a local chat provider is a sensible combination.
#   auto     follow MADO_AI_PROVIDER (default)
#   hashing  deterministic, offline, lexical only - not semantic
#   gemini   real semantic embeddings (requires MADO_GEMINI_API_KEY)
MADO_EMBEDDING_PROVIDER=auto

# Verified against the API, not the model listing - the listing still advertises
# gemini-2.0-flash even though generateContent returns 404 for it.
MADO_AI_FAST_MODEL=gemini-2.5-flash
MADO_AI_REASONING_MODEL=gemini-2.5-pro

# --- Abuse controls -----------------------------------------------------------
# Rate limiting is on in every deployed environment. It is off here because the
# integration tests run against this local server and legitimately create
# hundreds of accounts and posts in seconds - with limits on, they would be
# testing the limiter rather than the features. Never set this false in a
# deployed environment.
MADO_RATE_LIMIT_ENABLED=false

# Background maintenance jobs (popularity, trend, embedding backfill). Off here
# because the integration tests run against this server and a job firing mid-suite
# would rewrite the scores a test is asserting about. On in every deployment.
MADO_SCHEDULER_ENABLED=false

# --- Routing (spec MAP-002) ---------------------------------------------------
# Same shape as geocoding: the vendor knows the roads, Mado owns the plan.
#   auto      Google when a key is set, OSRM otherwise (default)
#   google    Google Routes - models traffic, so its durations are used as given
#   osrm      OpenStreetMap routing - keyless, which is what makes development work
#   estimate  offline straight-line arithmetic, no network at all
MADO_ROUTING_PROVIDER=auto
# The public demo server is rate limited and explicitly not for production.
# Point this at a self-hosted instance before relying on it.
MADO_OSRM_URL=https://router.project-osrm.org
# Which profiles that instance actually serves. The public one carries driving
# only; asking it to walk returns a driving route with a walking label, which is
# wrong by a factor of four, so walking falls back to an honest estimate.
MADO_OSRM_PROFILES=["drive"]

# --- Email (spec SECURITY-01) -------------------------------------------------
# Leave MADO_SMTP_HOST blank to run without a mail relay. In development that
# writes each message to backend/var/outbox instead of sending it, so email
# verification and password reset can be completed by opening the file and
# following the link. Any other environment logs a warning and sends nothing -
# running without a relay in a deployment is a misconfiguration, not a mode.
MADO_SMTP_HOST=
MADO_SMTP_PORT=587
MADO_SMTP_USERNAME=
MADO_SMTP_PASSWORD=
MADO_SMTP_USE_TLS=true
MADO_EMAIL_FROM=Mado <no-reply@mado.local>

# Where the links in those emails point. The API cannot work this out for
# itself - it may sit behind a proxy on a different host from the web client.
MADO_WEB_BASE_URL=http://localhost:5173

# Whether publishing requires a confirmed email address. Off here because it
# only means something once mail actually sends; with the outbox it would lock
# every publisher out of the thing they came to do. Turn it on in production
# alongside SMTP - an unverified address is an unlimited supply of publishing
# accounts, which is the cheapest spam vector there is.
MADO_REQUIRE_VERIFIED_EMAIL_TO_PUBLISH=false

# --- Observability (spec OPERATIONS-42) --------------------------------------
# Guards /metrics and /health/ready. Between them those describe every
# dependency, its latency, the shape of the traffic and where the errors are -
# reconnaissance, if they are reachable from the internet. With nothing set they
# answer only in development and test, so local work and CI need no setup and a
# production deployment that forgot fails closed rather than open.
MADO_TELEMETRY_TOKEN=

# --- Webhooks (spec DEV-003) -------------------------------------------------
# Endpoints are refused if they resolve to a private, loopback or link-local
# address - the SSRF guard, and the reason a receiver on your own machine is
# unreachable. This lifts it for local development only. Never set it outside
# development: it turns every webhook subscription into a way to make the API
# call our own internal services. The cloud metadata range stays blocked either
# way.
MADO_WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=false

# --- Places (geography is not Mado's data) -----------------------------------
# Countries, cities, districts, streets and landmarks are resolved from an
# external service when somebody asks, and never stored. That is what lets the
# platform work anywhere without a developer typing a place in first.
#   auto    Google when a key is set, OpenStreetMap otherwise (default)
#   google  Google Geocoding
#   osm     OpenStreetMap/Nominatim
#   stub    resolves nothing; tests and offline work
MADO_PLACES_PROVIDER=auto

# OpenStreetMap's operators require an identifying User-Agent and block traffic
# without one, and allow roughly one request a second across your whole
# deployment. Put a real contact address here before running in public, and
# consider a self-hosted Nominatim or a keyed provider under real traffic.
MADO_NOMINATIM_USER_AGENT=Mado/1.0 (city discovery; contact: ops@mado.local)
MADO_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Payments (spec COM-003; vendor 82.01 names Chapa for Ethiopia) ----------
# "stub" places real orders and holds real seats but never settles a payment by
# itself - the simulated checkout in development does that explicitly. A stub
# that reported success on its own would be indistinguishable from a working
# integration until the money did not arrive.
MADO_PAYMENT_PROVIDER=stub

# Chapa's secret key. Travels in an Authorization header, never a URL.
MADO_CHAPA_SECRET_KEY=
MADO_CHAPA_BASE_URL=https://api.chapa.co/v1

# Authenticates the provider's callback, which is the only unauthenticated
# write in the platform. Empty means every callback is refused, and that is the
# safe direction: a callback issues tickets, so a forgotten setting must not
# become a way into events for free. Set this in production.
MADO_PAYMENT_WEBHOOK_SECRET=

# Stripe: the intended primary once it is switched on, with Chapa kept for birr.
# Built and tested, off until you turn it on - while this is false, every order
# goes to MADO_PAYMENT_PROVIDER exactly as it does today. With it true, currency
# decides: ETB to Chapa, everything else to Stripe.
MADO_STRIPE_ENABLED=false
MADO_STRIPE_SECRET_KEY=
MADO_STRIPE_BASE_URL=https://api.stripe.com/v1
# Stripe signs callbacks with its own scheme and its own secret, so it does not
# share MADO_PAYMENT_WEBHOOK_SECRET. Empty refuses every Stripe callback.
MADO_STRIPE_WEBHOOK_SECRET=

# How long an unpaid order holds its places. Long enough to finish a bank
# redirect on a slow connection, short enough that a nearly-full event is not
# held empty by abandoned carts.
MADO_PAYMENT_HOLD_MINUTES=20

# --- Pilot city (spec: Addis Ababa) -----------------------------------------
MADO_DEFAULT_CITY_SLUG=addis-ababa

# --- Web client --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
